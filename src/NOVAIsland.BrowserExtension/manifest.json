{
  "manifest_version": 3,
  "name": "DOOM Island",
  "version": "2.4.9",
  "key": "",
  "description": "Detects active browser media (Media Session & HTML5 audio/video) and connects to the native DOOM Island desktop overlay via Native Messaging.",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "storage"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "DOOM Island Media Bridge"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}