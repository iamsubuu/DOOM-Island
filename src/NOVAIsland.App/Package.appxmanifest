<?xml version="1.0" encoding="utf-8"?>
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap3 desktop rescap">

  <Identity
    Name="DOOMIsland.App"
    Publisher="CN=DOOM Island"
    Version="2.3.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>DOOM Island</DisplayName>
    <PublisherDisplayName>DOOM Island</PublisherDisplayName>
    <Logo>Assets\Images\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="App"
      Executable="DOOMIsland.exe"
      EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="DOOM Island"
        Description="DOOM Island — Native Windows Dynamic Island"
        BackgroundColor="#06110B"
        Square150x150Logo="Assets\Images\Square150x150Logo.png"
        Square44x44Logo="Assets\Images\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Images\Wide310x150Logo.png" />
        <uap:SplashScreen Image="Assets\Images\SplashScreen.png" BackgroundColor="#06110B" />
      </uap:VisualElements>
      <Extensions>
        <desktop:Extension Category="windows.startupTask"
          Executable="DOOMIsland.exe"
          EntryPoint="Windows.FullTrustApplication">
          <desktop:StartupTask
            TaskId="DOOMIslandStartup"
            Enabled="false"
            DisplayName="DOOM Island" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <Capability Name="internetClient" />
    <rescap:Capability Name="runFullTrust" />
    <uap3:Capability Name="userNotificationListener" />
  </Capabilities>
</Package>
