<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dynamic Accent (updated live by ThemeManager) -->
    <Color x:Key="NovaAccentColor">#7AA2F7</Color>
    <SolidColorBrush x:Key="NovaAccentBrush" Color="{StaticResource NovaAccentColor}" />

    <!-- Venom Glassmorphism Dynamic Island Scope -->
    <SolidColorBrush x:Key="IslandPureBlackBrush" Color="#EB040509" />
    <SolidColorBrush x:Key="IslandObsidianBrush" Color="#E00B0D14" />
    <SolidColorBrush x:Key="IslandGraphiteBrush" Color="#DC141720" />
    <SolidColorBrush x:Key="IslandSurfaceBrush" Color="#E606080D" />

    <SolidColorBrush x:Key="IslandBorderSubtleBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="IslandBorderStrongBrush" Color="#38FFFFFF" />
    <SolidColorBrush x:Key="IslandBorderContrastBrush" Color="#5CFFFFFF" />

    <SolidColorBrush x:Key="IslandControlBgBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="IslandControlHoverBrush" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="IslandControlActiveBrush" Color="#2CFFFFFF" />
    <SolidColorBrush x:Key="IslandDividerBrush" Color="#1CFFFFFF" />

    <SolidColorBrush x:Key="IslandTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="IslandTextSecondaryBrush" Color="#FFA1A1AA" />
    <SolidColorBrush x:Key="IslandTextMutedBrush" Color="#FF71717A" />

    <!-- Semantic Brushes -->
    <SolidColorBrush x:Key="NovaSuccessBrush" Color="#FF34D399" />
    <SolidColorBrush x:Key="NovaWarningBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="NovaDangerBrush" Color="#FFFB7185" />
    <SolidColorBrush x:Key="NovaLinkBrush" Color="#FF7DD3FC" />

    <!-- Theme-Aware Glassmorphism Window Brushes (layered over DesktopAcrylicBackdrop) -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#AD0A0D14" />
    <SolidColorBrush x:Key="WindowSidebarBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="WindowCardBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="WindowCardHoverBrush" Color="#22FFFFFF" />
    <SolidColorBrush x:Key="WindowBorderBrush" Color="#2CFFFFFF" />
    <SolidColorBrush x:Key="WindowDividerBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="WindowInputBgBrush" Color="#24161924" />
    <SolidColorBrush x:Key="WindowTextPrimaryBrush" Color="#FFF4F4F5" />
    <SolidColorBrush x:Key="WindowTextSecondaryBrush" Color="#FFA1A1AA" />
    <SolidColorBrush x:Key="WindowTextMutedBrush" Color="#FF71717A" />
</ResourceDictionary>

