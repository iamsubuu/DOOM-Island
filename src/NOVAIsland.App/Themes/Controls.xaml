<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Minimalist 40x22 Pill ToggleSwitch matching NovaSwitch in Controls.tsx -->
    <Style x:Key="NovaToggleSwitchStyle" TargetType="ToggleSwitch">
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="OnContent" Value="{x:Null}" />
        <Setter Property="OffContent" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleSwitch">
                    <Grid Width="40" Height="22" Background="Transparent">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.92" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Opacity" To="0.4" Duration="0:0:0.1" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ToggleStates">
                                <VisualState x:Name="Off" />
                                <VisualState x:Name="On">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="KnobTransform" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.15" />
                                        <DoubleAnimation Storyboard.TargetName="TrackActive" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Grid x:Name="RootGrid">
                            <Border
                                x:Name="SwitchKnobBounds"
                                CornerRadius="11"
                                Background="#10FFFFFF"
                                BorderBrush="#26FFFFFF"
                                BorderThickness="1" />
                            <Border
                                x:Name="TrackActive"
                                CornerRadius="11"
                                Background="{StaticResource NovaAccentBrush}"
                                Opacity="0" />
                            <Ellipse
                                x:Name="SwitchKnobOn"
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="4,0,0,0"
                                Fill="#FFFFFFFF">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform x:Name="KnobTransform" X="0" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Thumb x:Name="SwitchThumb" Opacity="0" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Clean Island Tab Button -->
    <Style x:Key="IslandTabButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!-- Subtle Island Icon Button -->
    <Style x:Key="IslandIconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="6" />
    </Style>

    <!-- Precision 4px Slider -->
    <Style x:Key="NovaSliderStyle" TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource NovaAccentBrush}" />
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="MinHeight" Value="20" />
    </Style>
</ResourceDictionary>

