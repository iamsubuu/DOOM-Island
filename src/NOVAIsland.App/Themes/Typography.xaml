<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Bundled Font Families (matching index.html + index.css) -->
    <FontFamily x:Key="NovaPlusJakartaFont">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>
    <FontFamily x:Key="NovaManropeFont">ms-appx:///Assets/Fonts/Manrope-Variable.ttf#Manrope</FontFamily>
    <FontFamily x:Key="NovaOutfitFont">ms-appx:///Assets/Fonts/Outfit-Variable.ttf#Outfit</FontFamily>
    <FontFamily x:Key="NovaSegoeFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="NovaMonoFont">ms-appx:///Assets/Fonts/JetBrainsMono-Variable.ttf#JetBrains Mono</FontFamily>

    <!-- Active Font Family (updated live via ThemeManager) -->
    <FontFamily x:Key="NovaActiveFont">ms-appx:///Assets/Fonts/PlusJakartaSans-Regular.ttf#Plus Jakarta Sans</FontFamily>

    <Style x:Key="IslandTitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NovaActiveFont}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="IslandSubtitleTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NovaActiveFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource IslandTextSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="MonoTabularTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NovaMonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
    </Style>

    <Style x:Key="WindowHeadingTextStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource NovaActiveFont}" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource WindowTextPrimaryBrush}" />
    </Style>
</ResourceDictionary>

