<Window
    x:Class="NOVAIsland.App.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Title Bar -->
        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            BorderBrush="{StaticResource WindowDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="14" Foreground="{StaticResource NovaAccentBrush}" />
                <TextBlock x:Name="TitleBarBrandText" Text="DOOM Island Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                <TextBlock Text="·" Foreground="{StaticResource WindowTextMutedBrush}" />
                <TextBlock x:Name="TitleBarSectionText" Text="General" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar -->
            <Border Grid.Column="0" Background="{StaticResource WindowSidebarBrush}" BorderBrush="{StaticResource WindowDividerBrush}" BorderThickness="0,0,1,0" Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SidebarSearchBox" PlaceholderText="Find a setting..." TextChanged="OnSearchChanged" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarNavPanel" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Content Pane -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Padding="28" Spacing="16" MaxWidth="720" HorizontalAlignment="Left">
                    <Border BorderBrush="{StaticResource WindowDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="SectionTitleText" Text="General" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            <TextBlock x:Name="SectionSubtitleText" Text="" FontSize="12.5" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="SectionContentHost" Spacing="14" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
