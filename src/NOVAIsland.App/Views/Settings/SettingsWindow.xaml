<Window
    x:Class="NOVAIsland.App.Views.Settings.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Title Bar -->
        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            BorderBrush="{StaticResource WindowDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Image x:Name="TitleBarLogo" Width="18" Height="18" Stretch="Uniform" />
                <TextBlock x:Name="TitleBarBrandText" Text="DOOM Island Settings" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                <TextBlock Text="·" Foreground="{StaticResource WindowTextMutedBrush}" />
                <TextBlock x:Name="TitleBarSectionText" Text="General" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Left Sidebar (Wide Layout) -->
            <Border
                x:Name="SidebarContainer"
                Grid.Column="0"
                Background="{StaticResource WindowSidebarBrush}"
                BorderBrush="{StaticResource WindowDividerBrush}"
                BorderThickness="0,0,1,0"
                Padding="12">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SidebarSearchBox" PlaceholderText="Find a setting..." TextChanged="OnSearchChanged" />
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarNavPanel" Spacing="2" />
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Right Content Pane -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Compact Section Switcher Bar (Narrow Responsive Mode) -->
                <Border
                    x:Name="CompactNavBar"
                    Grid.Row="0"
                    Visibility="Collapsed"
                    Background="{StaticResource WindowSidebarBrush}"
                    BorderBrush="{StaticResource WindowDividerBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="20,10,20,10">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Section" FontSize="12.5" FontWeight="Medium" Foreground="{StaticResource WindowTextSecondaryBrush}" VerticalAlignment="Center" />
                        <ComboBox
                            x:Name="CompactSectionCombo"
                            Grid.Column="1"
                            HorizontalAlignment="Stretch"
                            SelectionChanged="OnCompactSectionChanged" />
                    </Grid>
                </Border>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid Padding="28,22,28,28">
                        <StackPanel Spacing="14" MaxWidth="780" HorizontalAlignment="Stretch">
                            <Border BorderBrush="{StaticResource WindowDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,14">
                                <StackPanel Spacing="4">
                                    <TextBlock x:Name="SectionTitleText" Text="General" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <TextBlock x:Name="SectionSubtitleText" Text="" FontSize="12.5" TextWrapping="Wrap" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                </StackPanel>
                            </Border>
                            <StackPanel x:Name="SectionContentHost" Spacing="12" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
