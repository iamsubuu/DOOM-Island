<UserControl
    x:Class="NOVAIsland.App.Views.Island.MusicPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NOVAIsland.App.Controls">
    <StackPanel Spacing="8">
        <!-- 3-Column Nook-Style Horizontal Notch Card -->
        <Grid ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- LEFT: Artwork + Track Metadata + Transport -->
            <Grid Grid.Column="0" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="66" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Width="66" Height="66" VerticalAlignment="Center">
                    <Border CornerRadius="14" BorderBrush="{StaticResource IslandBorderStrongBrush}" BorderThickness="1">
                        <controls:SafeMediaImage x:Name="AlbumArtwork" ImageCornerRadius="13" />
                    </Border>
                    <Border
                        Width="20"
                        Height="20"
                        CornerRadius="6"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="0,0,-2,-2"
                        Background="#E610131C"
                        BorderBrush="#33FFFFFF"
                        BorderThickness="1">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="10" Foreground="{StaticResource NovaAccentBrush}" />
                    </Border>
                </Grid>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="3">
                    <TextBlock
                        x:Name="TrackTitleText"
                        Text="No active browser media"
                        FontSize="13.5"
                        FontWeight="SemiBold"
                        Foreground="{StaticResource IslandTextPrimaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="TrackArtistText"
                        Text="Play in Chrome, Edge, or Opera"
                        FontSize="11.5"
                        Foreground="{StaticResource IslandTextSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="SourceBadgeText"
                        Text="Ready"
                        FontSize="10.5"
                        Foreground="{StaticResource IslandTextMutedBrush}"
                        TextTrimming="CharacterEllipsis" />

                    <!-- Compact Transport Controls -->
                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,4,0,0">
                        <Button x:Name="PrevButton" Click="OnPrevClick" Style="{StaticResource IslandIconButtonStyle}" Padding="5" ToolTipService.ToolTip="Previous">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="11.5" Foreground="{StaticResource IslandTextPrimaryBrush}" />
                        </Button>
                        <Button
                            x:Name="PlayPauseButton"
                            Click="OnPlayPauseClick"
                            Width="28"
                            Height="28"
                            CornerRadius="14"
                            Padding="0"
                            Background="#FFFFFFFF"
                            Foreground="#FF09090B"
                            BorderThickness="0">
                            <FontIcon x:Name="PlayPauseIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="11.5" Foreground="#FF09090B" />
                        </Button>
                        <Button x:Name="NextButton" Click="OnNextClick" Style="{StaticResource IslandIconButtonStyle}" Padding="5" ToolTipService.ToolTip="Next">
                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="11.5" Foreground="{StaticResource IslandTextPrimaryBrush}" />
                        </Button>
                        <Button
                            Click="OnFocusTabClick"
                            Style="{StaticResource IslandTabButtonStyle}"
                            Background="{StaticResource IslandControlBgBrush}"
                            Padding="7,3"
                            Margin="2,0,0,0"
                            ToolTipService.ToolTip="Focus browser window">
                            <TextBlock Text="Focus" FontSize="10.5" Foreground="{StaticResource IslandTextSecondaryBrush}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- CENTER: Calendar Week Strip + Live Lyric / Status Glance -->
            <Border
                Grid.Column="1"
                BorderBrush="{StaticResource IslandDividerBrush}"
                BorderThickness="1,0,1,0"
                Padding="12,2,12,2"
                VerticalAlignment="Center">
                <StackPanel Spacing="6">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="CalendarMonthText"
                            Grid.Column="0"
                            Text="Nov 27"
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource IslandTextPrimaryBrush}"
                            VerticalAlignment="Center" />
                        <TextBlock
                            x:Name="ExactTimeText"
                            Grid.Column="1"
                            Text="12:00:00 PM"
                            Style="{StaticResource MonoTabularTextStyle}"
                            FontSize="11.5"
                            FontWeight="SemiBold"
                            Foreground="{StaticResource NovaAccentBrush}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                    <StackPanel x:Name="WeekDaysStrip" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />

                    <Border
                        Padding="8,6"
                        CornerRadius="10"
                        Background="{StaticResource IslandControlBgBrush}"
                        BorderBrush="{StaticResource IslandBorderSubtleBrush}"
                        BorderThickness="1">
                        <StackPanel Spacing="2">
                            <TextBlock
                                x:Name="GlanceHeadlineText"
                                Text="DOOM Notch Ready"
                                FontSize="11"
                                FontWeight="Medium"
                                Foreground="{StaticResource IslandTextPrimaryBrush}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="GlanceSubtextText"
                                Text="Synced lyrics &amp; timer ready"
                                FontSize="10.5"
                                Foreground="{StaticResource IslandTextMutedBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- RIGHT: Equalizer, Audio & Quick Actions -->
            <StackPanel Grid.Column="2" Width="128" VerticalAlignment="Center" Spacing="8">
                <Border
                    Padding="10,8"
                    CornerRadius="12"
                    Background="{StaticResource IslandControlBgBrush}"
                    BorderBrush="{StaticResource IslandBorderSubtleBrush}"
                    BorderThickness="1">
                    <StackPanel Spacing="6">
                        <Grid>
                            <controls:AudioEqualizerControl x:Name="Equalizer" BarCount="7" MaxBarHeight="14" HorizontalAlignment="Left" />
                            <Button
                                Click="OnOpenFullscreenLyricsClick"
                                Style="{StaticResource IslandIconButtonStyle}"
                                Padding="3"
                                HorizontalAlignment="Right"
                                ToolTipService.ToolTip="Fullscreen Lyrics">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="11" />
                            </Button>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Button Click="OnToggleMuteClick" Style="{StaticResource IslandIconButtonStyle}" Padding="2">
                                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE767;" FontSize="11.5" />
                            </Button>
                            <Slider
                                x:Name="VolumeSlider"
                                Style="{StaticResource NovaSliderStyle}"
                                Width="80"
                                Minimum="0"
                                Maximum="100"
                                ValueChanged="OnVolumeChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button
                    Click="OnOpenLyricsClick"
                    HorizontalAlignment="Stretch"
                    Style="{StaticResource IslandTabButtonStyle}"
                    Background="{StaticResource IslandControlBgBrush}"
                    Padding="8,4">
                    <TextBlock Text="Live Lyrics" FontSize="11" Foreground="{StaticResource IslandTextPrimaryBrush}" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- Slim Timeline Seek Row -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock
                x:Name="ElapsedTimeText"
                Text="0:00"
                Style="{StaticResource MonoTabularTextStyle}"
                FontSize="10.5"
                Foreground="{StaticResource IslandTextMutedBrush}"
                VerticalAlignment="Center" />
            <Slider
                x:Name="SeekSlider"
                Grid.Column="1"
                Style="{StaticResource NovaSliderStyle}"
                Minimum="0"
                Maximum="100"
                Value="0"
                PointerCaptureLost="OnSeekCompleted" />
            <TextBlock
                x:Name="RemainingTimeText"
                Grid.Column="2"
                Text="-0:00"
                Style="{StaticResource MonoTabularTextStyle}"
                FontSize="10.5"
                Foreground="{StaticResource IslandTextMutedBrush}"
                VerticalAlignment="Center" />
        </Grid>

        <TextBlock
            x:Name="CommandStatusText"
            Visibility="Collapsed"
            FontSize="11"
            Foreground="{StaticResource NovaWarningBrush}" />

        <!-- Browser Tabs Strip (Visible when multiple media tabs are active) -->
        <ScrollViewer x:Name="BrowserTabsRow" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <StackPanel x:Name="BrowserTabsStrip" Orientation="Horizontal" Spacing="6" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
