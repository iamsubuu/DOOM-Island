<Window
    x:Class="NOVAIsland.App.Views.Island.DynamicIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NOVAIsland.App.Controls"
    xmlns:island="using:NOVAIsland.App.Views.Island">
    <Grid x:Name="RootHost" Background="Transparent">
        <!-- Centered Notch Assembly (Flared Bezel Ears + Notch Shell) -->
        <Grid
            x:Name="NotchAssembly"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            PointerEntered="OnPillPointerEntered"
            PointerExited="OnPillPointerExited"
            DoubleTapped="OnPillDoubleTapped">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Left Concave Bezel Shoulder (macOS / Nook Notch Ear) -->
            <Path
                x:Name="LeftNotchEar"
                Grid.Column="0"
                Width="12"
                Height="12"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Fill="{StaticResource IslandSurfaceBrush}"
                Data="M 0,0 L 12,0 L 12,12 A 12,12 0 0 0 0,0 Z" />

            <Border
                x:Name="PillShell"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Top"
                Width="216"
                CornerRadius="0,0,22,22"
                Background="{StaticResource IslandSurfaceBrush}"
                BorderBrush="{StaticResource IslandBorderStrongBrush}"
                BorderThickness="1,0,1,1">

                <Grid>
                    <!-- Live Theme Ambient Glow & Top Glossy Glass Sheen Layer -->
                    <Border
                        x:Name="DoomAmbientGlow"
                        IsHitTestVisible="False"
                        CornerRadius="{Binding ElementName=PillShell, Path=CornerRadius}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop x:Name="AmbientStop0" Color="#32A855F7" Offset="0" />
                                <GradientStop x:Name="AmbientStop1" Color="#1822D3EE" Offset="0.52" />
                                <GradientStop Color="#00000000" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <Border
                        x:Name="GlassSheenLayer"
                        IsHitTestVisible="False"
                        CornerRadius="{Binding ElementName=PillShell, Path=CornerRadius}">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop x:Name="GlassSheenTopStop" Color="#2CFFFFFF" Offset="0" />
                                <GradientStop x:Name="GlassSheenMidStop" Color="#08FFFFFF" Offset="0.26" />
                                <GradientStop Color="#00FFFFFF" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- Live Theme Energy Sweep along Bottom Glass Rim -->
                    <Border
                        x:Name="DoomEnergySweep"
                        IsHitTestVisible="False"
                        Width="160"
                        Height="2"
                        CornerRadius="1"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,1">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop x:Name="EnergySweepStartStop" Color="#00A855F7" Offset="0" />
                                <GradientStop x:Name="EnergySweepMidStop" Color="#CCA855F7" Offset="0.38" />
                                <GradientStop x:Name="EnergySweepMid2Stop" Color="#CC22D3EE" Offset="0.65" />
                                <GradientStop x:Name="EnergySweepEndStop" Color="#0022D3EE" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                    </Border>

                    <!-- 0. STEALTH TOP-BEZEL STATIC HOVER LINE -->
                    <Grid
                        x:Name="StealthBarView"
                        Visibility="Collapsed"
                        Height="10"
                        Background="#02000000">
                        <Border
                            x:Name="StealthHoverLine"
                            Width="108"
                            Height="4"
                            CornerRadius="0,0,4,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Margin="0"
                            BorderBrush="#3304120B"
                            BorderThickness="0,0,0,0.75">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop x:Name="StealthLineStartStop" Color="#22A855F7" Offset="0" />
                                    <GradientStop x:Name="StealthLineMidStop" Color="#EEA855F7" Offset="0.45" />
                                    <GradientStop x:Name="StealthLineMid2Stop" Color="#EE22D3EE" Offset="0.6" />
                                    <GradientStop x:Name="StealthLineEndStop" Color="#2222D3EE" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                    </Grid>

                    <!-- 1. COMPACT IDLE PILL -->
                    <Grid
                        x:Name="CompactView"
                        Height="36"
                        Padding="16,0,16,0"
                        Tapped="OnCompactTapped">
                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Ellipse
                                x:Name="CompactStatusDot"
                                Width="6"
                                Height="6"
                                Fill="{StaticResource NovaAccentBrush}" />
                            <Border
                                x:Name="IdleBreatheBar"
                                Width="18"
                                Height="2"
                                CornerRadius="1"
                                Background="{StaticResource NovaAccentBrush}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="CompactTimerBadge"
                                Visibility="Collapsed"
                                Style="{StaticResource MonoTabularTextStyle}"
                                Foreground="#FFE4E4E7" />
                            <TextBlock
                                x:Name="CompactAlertBadge"
                                Visibility="Collapsed"
                                Style="{StaticResource MonoTabularTextStyle}"
                                Foreground="#FFD4D4D8" />
                            <StackPanel x:Name="CompactIdleGroup" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Ready" FontSize="11" Foreground="{StaticResource IslandTextMutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <!-- 2. MUSIC COMPACT PILL -->
                    <Grid
                        x:Name="MusicPillView"
                        Visibility="Collapsed"
                        Height="40"
                        Padding="10,0,10,0"
                        Tapped="OnCompactTapped">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:SafeMediaImage
                                    x:Name="MusicPillArt"
                                    Width="24"
                                    Height="24"
                                    ImageCornerRadius="12" />
                                <TextBlock
                                    x:Name="MusicPillTitle"
                                    Text="Track"
                                    FontSize="12"
                                    FontWeight="Medium"
                                    Foreground="#FFFFFFFF"
                                    TextTrimming="CharacterEllipsis"
                                    MaxWidth="150"
                                    VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <controls:AudioEqualizerControl x:Name="CompactEqualizer" BarCount="5" MaxBarHeight="12" />
                                <Button
                                    Click="OnCompactPlayPauseClick"
                                    Width="26"
                                    Height="26"
                                    CornerRadius="13"
                                    Padding="0"
                                    Background="Transparent"
                                    BorderThickness="0">
                                    <FontIcon x:Name="CompactPlayIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE769;" FontSize="11" Foreground="#FFE4E4E7" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ProgressBar
                            x:Name="CompactProgressLine"
                            VerticalAlignment="Bottom"
                            Height="2"
                            Margin="10,0,10,0"
                            Minimum="0"
                            Maximum="100"
                            Foreground="{StaticResource NovaAccentBrush}"
                            Background="#12FFFFFF" />
                    </Grid>

                    <!-- 3. EXPANDED NOTCH SHELL -->
                    <Grid
                        x:Name="ExpandedShellView"
                        Visibility="Collapsed"
                        Padding="16,8,16,14"
                        RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Notch Bar (Tabs + Camera Dot + Actions) -->
                        <Grid Grid.Row="0" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="TopTabsPanel" Orientation="Horizontal" Spacing="3">
                                    <Button Tag="Expanded" Content="Notch" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="Activity" Content="Tray" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="Lyrics" Content="Lyrics" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="Clipboard" Content="Clipboard" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="Notifications" Content="Alerts" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="Timer" Content="Timer" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                    <Button Tag="System" Content="System" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" Padding="8,4" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Click="OnOpenSettingsClick" Style="{StaticResource IslandIconButtonStyle}" Padding="5" ToolTipService.ToolTip="Settings">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="11.5" />
                                </Button>
                                <Button Click="OnCollapseClick" Style="{StaticResource IslandIconButtonStyle}" Padding="5" ToolTipService.ToolTip="Collapse">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70E;" FontSize="11.5" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Active Panel Viewport -->
                        <Grid Grid.Row="1" x:Name="PanelContainer">
                            <island:MusicPanelView x:Name="MusicPanel" Visibility="Collapsed" />
                            <island:LyricsPanelView x:Name="LyricsPanel" Visibility="Collapsed" />
                            <island:ClipboardPanelView x:Name="ClipboardPanel" Visibility="Collapsed" />
                            <island:NotificationsPanelView x:Name="NotificationsPanel" Visibility="Collapsed" />
                            <island:TimerPanelView x:Name="TimerPanel" Visibility="Collapsed" />
                            <island:SystemPanelView x:Name="SystemPanel" Visibility="Collapsed" />
                            <island:ActivityPanelView x:Name="ActivityPanel" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Right Concave Bezel Shoulder (macOS / Nook Notch Ear) -->
            <Path
                x:Name="RightNotchEar"
                Grid.Column="2"
                Width="12"
                Height="12"
                VerticalAlignment="Top"
                Visibility="Collapsed"
                Fill="{StaticResource IslandSurfaceBrush}"
                Data="M 0,0 L 12,0 A 12,12 0 0 0 0,12 Z" />
        </Grid>
    </Grid>
</Window>
