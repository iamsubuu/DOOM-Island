<Window
    x:Class="NOVAIsland.App.Views.Island.DynamicIslandWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NOVAIsland.App.Controls"
    xmlns:island="using:NOVAIsland.App.Views.Island">
    <Grid x:Name="RootHost" Background="Transparent">
        <Border
            x:Name="PillShell"
            HorizontalAlignment="Center"
            VerticalAlignment="Top"
            Width="216"
            CornerRadius="22"
            Background="{StaticResource IslandSurfaceBrush}"
            BorderBrush="{StaticResource IslandBorderSubtleBrush}"
            BorderThickness="1"
            PointerEntered="OnPillPointerEntered"
            PointerExited="OnPillPointerExited"
            PointerPressed="OnPillPointerPressed"
            PointerMoved="OnPillPointerMoved"
            PointerReleased="OnPillPointerReleased"
            DoubleTapped="OnPillDoubleTapped">

            <Grid>
                <!-- 1. COMPACT IDLE PILL -->
                <Grid
                    x:Name="CompactView"
                    Height="36"
                    Padding="16,0,16,0"
                    Tapped="OnCompactTapped">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Ellipse
                            x:Name="CompactStatusDot"
                            Width="6"
                            Height="6"
                            Fill="{StaticResource NovaAccentBrush}" />
                        <TextBlock
                            x:Name="CompactWordmark"
                            Text="DOOM"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="#FFF4F4F5" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock
                            x:Name="CompactTimerBadge"
                            Visibility="Collapsed"
                            Style="{StaticResource MonoTabularTextStyle}"
                            Foreground="#FFE4E4E7" />
                        <TextBlock
                            x:Name="CompactAlertBadge"
                            Visibility="Collapsed"
                            Style="{StaticResource MonoTabularTextStyle}"
                            Foreground="#FFD4D4D8" />
                        <StackPanel x:Name="CompactIdleGroup" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <Border
                                x:Name="IdleBreatheBar"
                                Width="18"
                                Height="2"
                                CornerRadius="1"
                                Background="{StaticResource NovaAccentBrush}" />
                            <TextBlock Text="Ready" FontSize="11" Foreground="{StaticResource IslandTextMutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <!-- 2. MUSIC COMPACT PILL -->
                <Grid
                    x:Name="MusicPillView"
                    Visibility="Collapsed"
                    Height="40"
                    Padding="10,0,10,0"
                    Tapped="OnCompactTapped">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <controls:SafeMediaImage
                                x:Name="MusicPillArt"
                                Width="24"
                                Height="24"
                                ImageCornerRadius="12" />
                            <TextBlock
                                x:Name="MusicPillTitle"
                                Text="Track"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="#FFFFFFFF"
                                TextTrimming="CharacterEllipsis"
                                MaxWidth="150"
                                VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <controls:AudioEqualizerControl x:Name="CompactEqualizer" BarCount="5" MaxBarHeight="12" />
                            <Button
                                Click="OnCompactPlayPauseClick"
                                Width="26"
                                Height="26"
                                CornerRadius="13"
                                Padding="0"
                                Background="Transparent"
                                BorderThickness="0">
                                <FontIcon x:Name="CompactPlayIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE769;" FontSize="11" Foreground="#FFE4E4E7" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Bottom Progress Hairline -->
                    <ProgressBar
                        x:Name="CompactProgressLine"
                        VerticalAlignment="Bottom"
                        Height="2"
                        Margin="10,0,10,0"
                        Minimum="0"
                        Maximum="100"
                        Foreground="{StaticResource NovaAccentBrush}"
                        Background="#12FFFFFF" />
                </Grid>

                <!-- 3. EXPANDED MODULAR SHELL -->
                <StackPanel
                    x:Name="ExpandedShellView"
                    Visibility="Collapsed"
                    Padding="14"
                    Spacing="12">
                    <!-- Top Module Switcher Bar -->
                    <Border BorderBrush="{StaticResource IslandDividerBrush}" BorderThickness="0,0,0,1" Padding="0,0,0,10">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="0,0,64,0">
                                <StackPanel Orientation="Horizontal" Spacing="2">
                                    <Button Tag="Expanded" Content="Music" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Lyrics" Content="Lyrics" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Clipboard" Content="Clipboard" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Notifications" Content="Alerts" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Timer" Content="Timer" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="System" Content="System" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Activity" Content="Activity" Click="OnTabClick" Style="{StaticResource IslandTabButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>

                            <StackPanel Orientation="Horizontal" Spacing="2" HorizontalAlignment="Right">
                                <Button Click="OnOpenSettingsClick" Style="{StaticResource IslandIconButtonStyle}" ToolTipService.ToolTip="Settings">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE713;" FontSize="12" />
                                </Button>
                                <Button Click="OnCollapseClick" Style="{StaticResource IslandIconButtonStyle}" ToolTipService.ToolTip="Collapse">
                                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE70E;" FontSize="12" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Active Panel Viewport -->
                    <Grid x:Name="PanelContainer">
                        <island:MusicPanelView x:Name="MusicPanel" Visibility="Collapsed" />
                        <island:LyricsPanelView x:Name="LyricsPanel" Visibility="Collapsed" />
                        <island:ClipboardPanelView x:Name="ClipboardPanel" Visibility="Collapsed" />
                        <island:NotificationsPanelView x:Name="NotificationsPanel" Visibility="Collapsed" />
                        <island:TimerPanelView x:Name="TimerPanel" Visibility="Collapsed" />
                        <island:SystemPanelView x:Name="SystemPanel" Visibility="Collapsed" />
                        <island:ActivityPanelView x:Name="ActivityPanel" Visibility="Collapsed" />
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
