<UserControl
    x:Class="NOVAIsland.App.Views.Island.ClipboardPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Spacing="10">
        <!-- Search & Clear -->
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="SearchBox"
                PlaceholderText="Search clipboard history..."
                TextChanged="OnSearchChanged" />
            <Button
                Grid.Column="1"
                Content="Clear Unpinned"
                Click="OnClearUnpinnedClick"
                Style="{StaticResource IslandTabButtonStyle}"
                Background="{StaticResource IslandControlBgBrush}" />
        </Grid>

        <!-- Filter Pills -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Button Tag="All" Content="All" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
            <Button Tag="Pinned" Content="Pinned" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
            <Button Tag="Text" Content="Text" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
            <Button Tag="Code" Content="Code" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
            <Button Tag="Link" Content="Links" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
            <Button Tag="Image" Content="Images" Click="OnFilterClick" Style="{StaticResource IslandTabButtonStyle}" />
        </StackPanel>

        <!-- Items List -->
        <ScrollViewer MaxHeight="224" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ItemsHost" Spacing="6" />
        </ScrollViewer>
    </StackPanel>
</UserControl>
