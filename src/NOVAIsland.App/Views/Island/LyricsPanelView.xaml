<UserControl
    x:Class="NOVAIsland.App.Views.Island.LyricsPanelView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NOVAIsland.App.Controls">
    <StackPanel Spacing="12">
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="32" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <controls:SafeMediaImage x:Name="MiniArt" Width="32" Height="32" ImageCornerRadius="8" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TrackTitleText"
                    Text="No Track"
                    FontSize="13"
                    FontWeight="SemiBold"
                    Foreground="{StaticResource IslandTextPrimaryBrush}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="MetaText"
                    Text="LRCLIB"
                    FontSize="11"
                    Foreground="{StaticResource IslandTextSecondaryBrush}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                <Button
                    x:Name="SearchToggleBtn"
                    Click="OnToggleSearchClick"
                    Style="{StaticResource IslandTabButtonStyle}"
                    Background="{StaticResource IslandControlBgBrush}">
                    <TextBlock x:Name="SearchToggleLabel" Text="LRCLIB Search" FontSize="11.5" />
                </Button>
                <Button Click="OnOpenFullscreenClick" Style="{StaticResource IslandIconButtonStyle}" ToolTipService.ToolTip="Fullscreen Lyrics">
                    <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE740;" FontSize="12" />
                </Button>
            </StackPanel>
        </Grid>

        <ScrollViewer
            x:Name="LyricsScrollViewer"
            Height="184"
            VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="LyricsLinesPanel" Spacing="6" Padding="4,10,4,10" />
        </ScrollViewer>

        <StackPanel x:Name="SearchPanel" Visibility="Collapsed" Spacing="8">
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="SearchInput"
                    PlaceholderText="Search track or artist on LRCLIB..."
                    KeyDown="OnSearchKeyDown" />
                <Button Grid.Column="1" Content="Search" Click="OnSearchClick" />
            </Grid>
            <ScrollViewer MaxHeight="140" VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="SearchResultsPanel" Spacing="4" />
            </ScrollViewer>
        </StackPanel>

        <Border BorderBrush="{StaticResource IslandDividerBrush}" BorderThickness="0,1,0,0" Padding="0,8,0,0">
            <Grid>
                <TextBlock
                    x:Name="ProgressText"
                    Text="0:00 / 0:00"
                    Style="{StaticResource MonoTabularTextStyle}"
                    Foreground="{StaticResource IslandTextSecondaryBrush}"
                    VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right">
                    <Button Click="OnPrevClick" Style="{StaticResource IslandIconButtonStyle}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="12" />
                    </Button>
                    <Button
                        Click="OnPlayPauseClick"
                        Width="28"
                        Height="28"
                        CornerRadius="14"
                        Padding="0"
                        Background="#FFFFFFFF"
                        Foreground="#FF09090B"
                        BorderThickness="0">
                        <FontIcon x:Name="MiniPlayIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="12" Foreground="#FF09090B" />
                    </Button>
                    <Button Click="OnNextClick" Style="{StaticResource IslandIconButtonStyle}">
                        <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
