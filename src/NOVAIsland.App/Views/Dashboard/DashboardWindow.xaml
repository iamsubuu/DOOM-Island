<Window
    x:Class="NOVAIsland.App.Views.Dashboard.DashboardWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:NOVAIsland.App.Controls">
    <Grid Background="{StaticResource WindowBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Minimalist Title Bar -->
        <Border
            x:Name="AppTitleBar"
            Grid.Row="0"
            BorderBrush="{StaticResource WindowDividerBrush}"
            BorderThickness="0,0,0,1"
            Padding="16,0,140,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE8D6;" FontSize="14" Foreground="{StaticResource NovaAccentBrush}" />
                <TextBlock x:Name="TitleBarBrandText" Text="DOOM Island" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                <TextBlock Text="·" Foreground="{StaticResource WindowTextMutedBrush}" />
                <TextBlock Text="Desktop Control Hub" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
            </StackPanel>
        </Border>

        <!-- Main Responsive Scrollable Hub -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Padding="24,20,24,28">
                <StackPanel Spacing="20" MaxWidth="1120" HorizontalAlignment="Stretch">
                    <!-- Heading + Direct Actions -->
                    <Grid x:Name="HeroGrid" ColumnSpacing="16" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Column="0" Grid.Row="0" Spacing="4">
                            <TextBlock x:Name="HeroTitle" Text="DOOM Island Dashboard" Style="{StaticResource WindowHeadingTextStyle}" TextWrapping="Wrap" />
                            <TextBlock x:Name="BridgeStatusSummary" Text="Browser media &amp; Windows OS modules live-synced with the floating notch." FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="HeroActionsPanel" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Positioning" Click="OnOpenPositionClick" Padding="12,8" CornerRadius="8" />
                            <Button Content="Customize Island" Click="OnOpenAppearanceClick" Padding="14,8" CornerRadius="8" Background="{StaticResource NovaAccentBrush}" Foreground="#FF06100A" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Island State Bar -->
                    <StackPanel Spacing="10">
                        <Grid x:Name="StateHeaderGrid" ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Column="0" Grid.Row="0" Text="Active Island State" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            <StackPanel x:Name="StateQuickActions" Grid.Column="1" Grid.Row="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                <Button Content="Capture Snip" Click="OnCaptureSnipClick" Padding="10,4" FontSize="12" CornerRadius="6" />
                                <Button Content="Fullscreen Lyrics" Click="OnOpenFullscreenLyricsClick" Padding="10,4" FontSize="12" CornerRadius="6" />
                            </StackPanel>
                        </Grid>

                        <Border Padding="4" CornerRadius="12" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="StateButtonsPanel" Orientation="Horizontal" Spacing="4">
                                    <Button Tag="Compact" Content="Compact" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Music" Content="Music" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Expanded" Content="Notch" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Lyrics" Content="Lyrics" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Clipboard" Content="Clipboard" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Notifications" Content="Notifications" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Timer" Content="Timer" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="System" Content="System" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                    <Button Tag="Activity" Content="Activity" Click="OnStateButtonClick" Style="{StaticResource IslandTabButtonStyle}" />
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- Responsive 2-Column Overview Grid -->
                    <Grid x:Name="OverviewGrid" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition x:Name="OverviewCol0" Width="7*" />
                            <ColumnDefinition x:Name="OverviewCol1" Width="5*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Currently Playing Card -->
                        <Border x:Name="NowPlayingCard" Grid.Column="0" Grid.Row="0" Padding="18" CornerRadius="16" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="14">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="NowPlayingMeta" Grid.Column="0" Text="Browser Media · Ready" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                        <Button Content="Island Lyrics" Click="OnJumpLyricsClick" Padding="10,4" FontSize="11.5" CornerRadius="6" />
                                        <Button Content="Fullscreen" Click="OnOpenFullscreenLyricsClick" Padding="10,4" FontSize="11.5" CornerRadius="6" />
                                    </StackPanel>
                                </Grid>

                                <Grid ColumnSpacing="14" RowSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <controls:SafeMediaImage x:Name="DashArtwork" Grid.Column="0" Grid.Row="0" Width="72" Height="72" ImageCornerRadius="12" />
                                    <StackPanel Grid.Column="1" Grid.Row="0" VerticalAlignment="Center" Spacing="3">
                                        <TextBlock x:Name="DashTitle" Text="No Active Browser Media" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DashArtist" Text="Start playback in Chrome, Edge, or Opera" FontSize="12.5" Foreground="{StaticResource WindowTextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="DashAlbum" Text="" FontSize="11.5" Foreground="{StaticResource WindowTextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel x:Name="DashTransportPanel" Grid.Column="2" Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                        <Button Click="OnPrevClick" Padding="8" CornerRadius="8">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE892;" FontSize="12.5" />
                                        </Button>
                                        <Button Click="OnPlayPauseClick" Width="38" Height="38" CornerRadius="19" Padding="0" Background="{StaticResource NovaAccentBrush}" Foreground="#FF06100A">
                                            <FontIcon x:Name="DashPlayIcon" FontFamily="Segoe MDL2 Assets" Glyph="&#xE768;" FontSize="13.5" Foreground="#FF06100A" />
                                        </Button>
                                        <Button Click="OnNextClick" Padding="8" CornerRadius="8">
                                            <FontIcon FontFamily="Segoe MDL2 Assets" Glyph="&#xE893;" FontSize="12.5" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <StackPanel Spacing="4">
                                    <ProgressBar x:Name="DashProgress" Minimum="0" Maximum="100" Height="5" Foreground="{StaticResource NovaAccentBrush}" />
                                    <Grid>
                                        <TextBlock x:Name="DashElapsed" Text="0:00" Style="{StaticResource MonoTabularTextStyle}" Foreground="{StaticResource WindowTextMutedBrush}" />
                                        <TextBlock x:Name="DashDuration" Text="0:00" Style="{StaticResource MonoTabularTextStyle}" Foreground="{StaticResource WindowTextMutedBrush}" HorizontalAlignment="Right" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Quick Toggles & Live Integrations -->
                        <Border x:Name="LiveControlsCard" Grid.Column="1" Grid.Row="0" Padding="18" CornerRadius="16" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <Grid ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Live Controls &amp; Integrations" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <Button Grid.Column="1" Content="All Settings" Click="OnOpenSettingsClick" HorizontalAlignment="Right" Padding="10,4" FontSize="11.5" CornerRadius="6" />
                                </Grid>

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Dynamic Island Visible" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <ToggleSwitch x:Name="IslandVisibleToggle" Grid.Column="1" Style="{StaticResource NovaToggleSwitchStyle}" MinWidth="40" Padding="0" HorizontalAlignment="Right" Toggled="OnIslandVisibleToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Browser Media Bridge" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <ToggleSwitch x:Name="BrowserBridgeToggle" Grid.Column="1" Style="{StaticResource NovaToggleSwitchStyle}" MinWidth="40" Padding="0" HorizontalAlignment="Right" Toggled="OnBrowserBridgeToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="LRCLIB Lyrics Sync" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <ToggleSwitch x:Name="LrclibToggle" Grid.Column="1" Style="{StaticResource NovaToggleSwitchStyle}" MinWidth="40" Padding="0" HorizontalAlignment="Right" Toggled="OnLrclibToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Clipboard Monitor" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <ToggleSwitch x:Name="ClipboardToggle" Grid.Column="1" Style="{StaticResource NovaToggleSwitchStyle}" MinWidth="40" Padding="0" HorizontalAlignment="Right" Toggled="OnClipboardToggled" />
                                </Grid>
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Focus / Do Not Disturb" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                    <ToggleSwitch x:Name="DndToggle" Grid.Column="1" Style="{StaticResource NovaToggleSwitchStyle}" MinWidth="40" Padding="0" HorizontalAlignment="Right" Toggled="OnDndToggled" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Responsive 4 Overview Cards -->
                    <Grid x:Name="CardsGrid" ColumnSpacing="14" RowSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="CardsCol2" Width="*" />
                            <ColumnDefinition x:Name="CardsCol3" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Button x:Name="CardSystem" Grid.Column="0" Grid.Row="0" Tag="System" Click="OnStateButtonClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" CornerRadius="12" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="System &amp; Audio" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                <TextBlock x:Name="CardSystemValue" Text="CPU 0% · RAM 0%" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CardTimer" Grid.Column="1" Grid.Row="0" Tag="Timer" Click="OnStateButtonClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" CornerRadius="12" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Focus Timer" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                <TextBlock x:Name="CardTimerValue" Text="25:00 · Ready" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CardClip" Grid.Column="2" Grid.Row="0" Tag="Clipboard" Click="OnStateButtonClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" CornerRadius="12" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Clipboard Vault" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                <TextBlock x:Name="CardClipValue" Text="0 Saved Items" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CardActivity" Grid.Column="3" Grid.Row="0" Tag="Activity" Click="OnStateButtonClick" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16" CornerRadius="12" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="4">
                                <TextBlock Text="Activity &amp; Alerts" FontSize="12" Foreground="{StaticResource WindowTextSecondaryBrush}" />
                                <TextBlock x:Name="CardActivityValue" Text="0 Active Tasks" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Responsive Bottom 2-Column Split -->
                    <Grid x:Name="FeedsGrid" ColumnSpacing="16" RowSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="FeedsCol1" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border x:Name="RecentClipboardCard" Grid.Column="0" Grid.Row="0" Padding="18" CornerRadius="16" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recent Clipboard Entries" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                <StackPanel x:Name="RecentClipboardList" Spacing="8" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="RecentActivityCard" Grid.Column="1" Grid.Row="0" Padding="18" CornerRadius="16" Background="{StaticResource WindowCardBrush}" BorderBrush="{StaticResource WindowBorderBrush}" BorderThickness="1">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Recent Activity &amp; Notifications" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource WindowTextPrimaryBrush}" />
                                <StackPanel x:Name="RecentActivityList" Spacing="8" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
