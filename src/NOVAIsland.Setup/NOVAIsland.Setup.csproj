<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NOVAIsland.Setup</RootNamespace>
    <Authors>ArcSubash</Authors>
    <Company>ArcSubash</Company>
    <Version Condition="'$(Version)' == ''">2.5.3</Version>
    <AssemblyName>DOOMIsland-Setup-x64-v$(Version)</AssemblyName>
    <ApplicationIcon>..\NOVAIsland.App\Assets\DOOMIsland.ico</ApplicationIcon>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\NOVAIsland.App\Assets\Images\DOOMIsland-Logo.png"
                      LogicalName="DOOMIsland.Logo.png" />
    <EmbeddedResource Include="..\..\artifacts\publish\DOOMIsland-AppPayload.zip"
                      LogicalName="DOOMIsland.Payload.zip"
                      Condition="Exists('..\..\artifacts\publish\DOOMIsland-AppPayload.zip')" />
  </ItemGroup>
</Project>
