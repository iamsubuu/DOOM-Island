<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>NOVAIsland.Setup</RootNamespace>
    <AssemblyName>DOOMIsland-Setup-x64-v2.3.1</AssemblyName>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\artifacts\publish\DOOMIsland-AppPayload.zip"
                      LogicalName="DOOMIsland.Payload.zip"
                      Condition="Exists('..\..\artifacts\publish\DOOMIsland-AppPayload.zip')" />
  </ItemGroup>
</Project>
